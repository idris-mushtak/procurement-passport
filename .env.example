# ---- Supabase (fill after the project exists) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# ---- Nebius Token Factory ----
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ---- Anthropic (SMART tier; optional) ----
# Leave blank to run Nebius-only. SMART_PROVIDER=nebius uses DeepSeek-V4-Pro.
ANTHROPIC_API_KEY=
SMART_PROVIDER=nebius
DISABLE_SMART=false

# ---- Model IDs (verified against GET /v1/models) ----
PP_MODEL_EMBED=Qwen/Qwen3-Embedding-8B
PP_MODEL_SMALL=Qwen/Qwen3-30B-A3B-Instruct-2507
PP_MODEL_SMART=claude-fable-5
PP_MODEL_SMART_FALLBACK=deepseek-ai/DeepSeek-V4-Pro

# ---- Cascade thresholds ----
PP_T_PASS=0.80
PP_T_GAP=0.70
PP_T_SMART=0.80
PP_LLM_CONCURRENCY=16

# ---- Extraction pipeline ----
PP_TODAY=2026-09-23
PP_N_TENDERS=12
PP_N_PARTNERS=30
